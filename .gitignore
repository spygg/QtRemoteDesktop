# 编译输出和构建目录
# 仅忽略名为 build 的目录（含任意层级，如第三方源码内的 build/），
# 不再用 */*build*/*（会误伤 linux_build_script / windows_build_script 等
# 目录名含 build 的构建脚本）。顶层 build/ 与 build_output/ 由下方 build*/ 覆盖。
**/build/
*/bin/*
*/dist/*
build*/
build_output/
bin/
bin64/
dist/
dist64/

# FFmpeg 源码树内的 install/ 是某次本地构建的安装产物（头文件+pkgconfig），
# 构建实际用的是 build_output*/ffmpeg_install-*，源码随仓库提供，产物不入库
src/remotedesk/thridparty/ffmpeg/install/

# 第三方源码自带的 build/ 是源码（makefile/cmake/gyp 脚本），不是构建产物；
# 缺了它们，全新 clone 与 CI 上 openh264 / mpp / breakpad 直接编不出来。
!src/remotedesk/thridparty/breakpad/src/build/
!src/remotedesk/thridparty/mpp/build/
!src/remotedesk/thridparty/third_party_src/openh264/build/

# Qt 临时文件
*.user
*.autosave
*.pro.user
*.pro.user.*

# 编译器临时文件
*.o
*.obj
*.pch
*.pdb
*.ilk
*.ncb
*.idb
*.ipch
*.suo
*.sdf
*.opensdf
*.vcxproj.filters
*.vcxproj.user

# 动态库和可执行文件
*.dll
*.exe
*.so
*.so.*
*.dylib
*.app

# FFmpeg 二进制文件(库文件和 DLL),但保留头文件(include)
src/remotedesk/thridparty/ffmpeg/windows/bin/
src/remotedesk/thridparty/ffmpeg/windows/lib/
src/remotedesk/thridparty/ffmpeg/windows/include/
src/remotedesk/thridparty/ffmpeg/windows/doc/
src/remotedesk/thridparty/ffmpeg/windows/presets/
src/remotedesk/thridparty/ffmpeg/linux/bin/
src/remotedesk/thridparty/ffmpeg/linux/lib/
src/remotedesk/thridparty/ffmpeg/linux/doc/
src/remotedesk/thridparty/ffmpeg/linux/man/
src/remotedesk/thridparty/ffmpeg/linux/presets/

# 文档文件
*.txt
!CMakeLists.txt
!**/CMakeLists.txt
*.md.bak

# 压缩文件
*.zip
*.rar
*.7z
*.tar
*.tar.gz
# OpenSSL 1.0.2u 源码包：Linux 构建的硬依赖（missing 即 CMake FATAL_ERROR），必须入库
!src/remotedesk/thridparty/third_party_src/openssl/openssl-1.0.2u.tar.gz

# 数据库文件
*.db
*.sqlite
*.sqlite3

# Node.js
*/node_modules/*

# IDE 配置文件
.vscode/
.idea/
*.swp
*.swo
*~

# 日志文件
*.log

# 操作系统文件
.DS_Store
Thumbs.db
desktop.ini

# 代理/调试工具的临时工作目录（脚本、抓包、构建试验，不进仓库）
.workbuddy/
.playwright-cli/